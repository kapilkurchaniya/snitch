# Root gitignore

# Node dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example


# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs (adjust if your project uses them)
dist/
build/
coverage/

# Misc
.DS_Store

# Process files
*.pid
*.seed

# Optional: runtime config files
*.local

